// Email validation core
const ok = v => /@andrew\.cmu\.edu$/i.test(v.trim());
emailInput.addEventListener('blur', () => {
  const bad = emailInput.value && !ok(emailInput.value);
  emailInput.classList.toggle('is-error', bad);
  errorEl.hidden = !bad; // text: "Use your @andrew.cmu.edu email address."
});

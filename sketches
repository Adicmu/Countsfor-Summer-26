<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>CountsFor CMU-Q — Layout Sketches</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800;9..144,900&display=swap" rel="stylesheet">
<style>
  :root {
    --cmu-red: #C41230;
    --cmu-red-bright: #E11D2E;
    --cmu-red-deep: #8A0A20;
    --cmu-red-soft: rgba(225,29,46,0.12);
    --ink-0: #0A0E14;
    --ink-1: #0F141C;
    --ink-2: #161C26;
    --ink-3: #1E2530;
    --line: #232A36;
    --text: #E8EAED;
    --text-dim: #8A93A1;
    --text-muted: #5A6373;
    --gened: #E89328;
    --white: #FFFFFF;
  }
  *,*::before,*::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--ink-0);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
    min-height: 100vh;
  }

  .switcher {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 14, 20, 0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
    padding: 18px 32px;
    display: flex;
    gap: 8px;
    justify-content: center;
  }
  .switcher button {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--text-dim);
    padding: 9px 20px;
    border-radius: 999px;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    transition: all .18s ease;
  }
  .switcher button:hover { border-color: var(--text-muted); color: var(--text); }
  .switcher button.active {
    background: var(--cmu-red);
    color: white;
    border-color: var(--cmu-red);
  }

  .direction { display: none; padding: 32px; }
  .direction.active { display: block; }

  .frame {
    background: var(--ink-1);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 40px 100px -30px rgba(0,0,0,0.5);
    border: 1px solid var(--line);
    max-width: 1500px;
    margin: 0 auto 24px;
  }
  .frame-label {
    padding: 12px 20px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: var(--ink-0);
    border-bottom: 1px solid var(--line);
  }
  .screens {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
  }
  .screen {
    position: relative;
    min-height: 660px;
    border-right: 1px solid var(--line);
    overflow: hidden;
  }
  .screen:last-child { border-right: none; }
  .screen-caption {
    position: absolute;
    top: 12px; right: 12px;
    z-index: 5;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 4px 8px;
    border-radius: 4px;
    color: var(--text-dim);
  }

  /* ==========================================================
     SKETCH 1 — SPACIOUS STACKED (rebuilt for breathing room)
     Onboarding: one clean column. Home: hero search dominant,
     requirements minimised to a quiet entry-point link.
     ========================================================== */
  /* Onboarding 1 — single column, calm */
  .s1-onb {
    height: 660px;
    background: var(--ink-1);
    padding: 0;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .s1-onb::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--cmu-red);
  }
  .s1-onb .topbar {
    padding: 22px 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .s1-onb .topbar .wm {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 11.5px;
    line-height: 0.94;
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .s1-onb .topbar .wm .l { display: block; }
  .s1-onb .topbar .step {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .s1-onb .main {
    flex: 1;
    padding: 24px 48px 36px;
    max-width: 460px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }
  .s1-onb .header { margin-bottom: 36px; }
  .s1-onb h1 {
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 8px;
  }
  .s1-onb .lede {
    color: var(--text-dim);
    font-size: 14px;
    margin: 0;
  }
  .s1-onb .group { margin-bottom: 28px; }
  .s1-onb .group label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-bottom: 12px;
  }
  .s1-onb .seg {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--ink-2);
    border-radius: 8px;
    padding: 4px;
    gap: 2px;
  }
  .s1-onb .seg button {
    background: transparent;
    border: none;
    color: var(--text-dim);
    padding: 11px 8px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    border-radius: 6px;
  }
  .s1-onb .seg button.sel {
    background: var(--cmu-red-bright);
    color: white;
  }
  .s1-onb .row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .s1-onb .row .opt {
    background: var(--ink-2);
    border: 1px solid var(--line);
    color: var(--text-dim);
    padding: 9px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all .15s;
  }
  .s1-onb .row .opt:hover { border-color: var(--text-muted); color: var(--text); }
  .s1-onb .row .opt.sel {
    background: var(--cmu-red);
    border-color: var(--cmu-red);
    color: white;
  }
  .s1-onb .actions {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .s1-onb .actions .skip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    cursor: pointer;
  }
  .s1-onb .actions .cont {
    background: var(--cmu-red-bright);
    color: white;
    border: none;
    padding: 11px 24px;
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  /* Home 1 — search dominates, tree teased not shown */
  .s1-home {
    height: 660px;
    display: flex;
    flex-direction: column;
  }
  .s1-home .nav {
    padding: 18px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--line);
  }
  .s1-home .nav .brand {
    display: flex; align-items: baseline; gap: 12px;
  }
  .s1-home .nav .brand .product {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .s1-home .nav .brand .product .red { color: var(--cmu-red-bright); }
  .s1-home .nav .brand .wm {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.16em;
  }
  .s1-home .nav .right {
    display: flex; gap: 8px; align-items: center;
  }
  .s1-home .nav .controls {
    display: flex;
    gap: 2px;
    background: var(--ink-2);
    padding: 3px;
    border-radius: 8px;
  }
  .s1-home .nav .controls button {
    background: transparent;
    border: none;
    color: var(--text-dim);
    padding: 5px 11px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    cursor: pointer;
    border-radius: 5px;
  }
  .s1-home .nav .controls button.on {
    background: var(--cmu-red);
    color: white;
  }
  .s1-home .nav .role {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    color: var(--cmu-red-bright);
    letter-spacing: 0.1em;
    border: 1px solid var(--cmu-red-bright);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .s1-home .hero {
    flex: 1;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
    width: 100%;
  }
  .s1-home .hero h1 {
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.0;
    margin: 0 0 14px;
  }
  .s1-home .hero h1 .red { color: var(--cmu-red-bright); }
  .s1-home .hero p {
    color: var(--text-dim);
    font-size: 15px;
    margin: 0 0 32px;
    max-width: 400px;
  }
  .s1-home .hero .search {
    width: 100%;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    transition: border-color .15s;
  }
  .s1-home .hero .search:focus-within { border-color: var(--cmu-red-bright); }
  .s1-home .hero .search .icn { color: var(--cmu-red-bright); font-size: 18px; }
  .s1-home .hero .search input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-size: 16px;
  }
  .s1-home .hero .search input::placeholder { color: var(--text-muted); }
  .s1-home .hero .search .kbd {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--text-muted);
    border: 1px solid var(--line);
    padding: 3px 7px;
    border-radius: 4px;
  }
  .s1-home .hero .or {
    margin: 22px 0 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--text-muted);
  }
  .s1-home .hero .browse {
    color: var(--text);
    font-size: 13.5px;
    font-weight: 500;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 6px;
    transition: color .15s;
  }
  .s1-home .hero .browse:hover { color: var(--cmu-red-bright); }
  .s1-home .hero .browse .arr { font-family: 'JetBrains Mono', monospace; font-size: 13px; }
  .s1-home .footer {
    padding: 14px 28px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  /* ==========================================================
     SKETCH 2 — SIDE BY SIDE (unchanged, current-style)
     ========================================================== */
  .s2-onb {
    height: 660px;
    background: var(--ink-1);
    padding: 0;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .s2-onb::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--cmu-red);
  }
  .s2-onb .topbar {
    padding: 22px 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .s2-onb .topbar .wm {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 11.5px;
    line-height: 0.94;
    letter-spacing: 0.02em;
  }
  .s2-onb .topbar .wm .l { display: block; }
  .s2-onb .topbar .step {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .s2-onb .step b { color: var(--cmu-red-bright); }
  .s2-onb .body {
    flex: 1;
    padding: 12px 36px 28px;
    display: flex;
    flex-direction: column;
    max-width: 640px;
    width: 100%;
    margin: 0 auto;
  }
  .s2-onb .header { margin: 24px 0 28px; }
  .s2-onb h2 {
    font-size: 38px;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 0 0 6px;
    line-height: 1.05;
  }
  .s2-onb .body p { color: var(--text-dim); font-size: 14px; margin: 0; }
  .s2-onb .group { margin-bottom: 20px; }
  .s2-onb .group label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-bottom: 10px;
  }
  .s2-onb .pills { display: flex; gap: 6px; flex-wrap: wrap; }
  .s2-onb .pills .p {
    border: 1px solid var(--line);
    background: var(--ink-2);
    padding: 9px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    color: var(--text-dim);
    transition: all .15s ease;
  }
  .s2-onb .pills .p:hover { border-color: var(--text-muted); color: var(--text); }
  .s2-onb .pills .p.sel {
    background: var(--cmu-red);
    color: white;
    border-color: var(--cmu-red);
  }
  .s2-onb .pills .p .sub {
    font-size: 10px;
    color: var(--text-muted);
    margin-left: 4px;
    font-family: 'JetBrains Mono', monospace;
  }
  .s2-onb .pills .p.sel .sub { color: rgba(255,255,255,0.7); }
  .s2-onb .actions {
    margin-top: auto;
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    align-items: center;
  }
  .s2-onb .actions .skip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    cursor: pointer;
  }
  .s2-onb .actions .cont {
    background: var(--cmu-red-bright);
    color: white;
    border: none;
    padding: 10px 22px;
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .s2-home {
    height: 660px;
    display: flex;
    flex-direction: column;
  }
  .s2-home .nav {
    padding: 14px 28px;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .s2-home .nav .brand {
    display: flex; align-items: baseline; gap: 10px;
  }
  .s2-home .nav .brand .wm {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 11px;
    line-height: 0.94;
    letter-spacing: 0.02em;
  }
  .s2-home .nav .brand .wm .l { display: block; }
  .s2-home .nav .brand .product {
    font-size: 14px;
    font-weight: 700;
    padding-left: 12px;
    border-left: 1px solid var(--line);
  }
  .s2-home .nav .brand .product .red { color: var(--cmu-red-bright); }
  .s2-home .nav .controls {
    display: flex;
    gap: 2px;
    background: var(--ink-2);
    padding: 3px;
    border-radius: 8px;
  }
  .s2-home .nav .controls button {
    background: transparent;
    border: none;
    color: var(--text-dim);
    padding: 5px 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    cursor: pointer;
    border-radius: 5px;
  }
  .s2-home .nav .controls button.on { background: var(--cmu-red); color: white; }
  .s2-home .nav .role {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    color: var(--cmu-red-bright);
    letter-spacing: 0.1em;
    border: 1px solid var(--cmu-red-bright);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .s2-home .body {
    flex: 1;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    overflow: hidden;
  }
  .s2-home .col { padding: 24px 24px 18px; }
  .s2-home .col.left { border-right: 1px solid var(--line); }
  .s2-home .col h1 {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 4px;
    line-height: 1.1;
  }
  .s2-home .col h1 .red { color: var(--cmu-red-bright); }
  .s2-home .col .sub {
    color: var(--text-dim);
    font-size: 13px;
    margin: 0 0 18px;
  }
  .s2-home .col .search {
    background: var(--ink-2);
    border: 1px solid var(--line);

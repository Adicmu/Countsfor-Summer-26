    cursor: pointer;
  }
  .s2-home .req-group .item:hover .nm { color: var(--cmu-red-bright); }
  .s2-home .req-group .item .nm { display: flex; align-items: center; gap: 8px; transition: color .15s; }
  .s2-home .req-group .item .nm .chev { color: var(--text-muted); font-size: 9px; }
  .s2-home .req-group .item .r { display: flex; gap: 8px; align-items: center; }
  .s2-home .req-group .item .rule {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.14em;
    color: var(--cmu-red-bright);
    border: 1px solid var(--cmu-red-bright);
    padding: 2px 6px;
    border-radius: 3px;
    background: var(--cmu-red-soft);
  }
  .s2-home .req-group .item .rule.gened {

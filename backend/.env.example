# Copy this file to `.env` for local development.
# In production (Render), set these as env vars in the dashboard instead.

# Random 32+ byte string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-me-locally

# SQLite for local dev. Production: Render Postgres or Supabase URI (see docs/SUPABASE_HOSTING.md).
DATABASE_URL=sqlite:///countsfor.db

# Optional path to JSON file of pre-seeded faculty profiles (see seed_users.example.json)
SEED_USERS_PATH=

# Production Postgres — works with Render or Supabase connection strings.
# Supabase: Project Settings → Database → Connection string (URI), use Session pooler.

# Google OAuth client ID — create one at https://console.cloud.google.com/apis/credentials
# Type: "Web application". Authorized JavaScript origins should include:
#   http://localhost:8765           (local frontend)
#   https://adicmu.github.io        (production frontend)
GOOGLE_CLIENT_ID=

# Optional. If set, only Google accounts with this email domain can sign in.
ALLOWED_EMAIL_DOMAIN=andrew.cmu.edu

# Comma-separated emails that are auto-promoted to admin on every login.
# Admin OVERRIDES the seed file and any self-selected role. Set the SAME value
# in the Render dashboard for production (this file is dev guidance only).
# hbouamor = Prof. Houda Bouamor.
ADMIN_EMAILS=avivek@andrew.cmu.edu,hbouamor@andrew.cmu.edu,spessoa@andrew.cmu.edu

# CORS allow-list. The frontend's origin (no path).
FRONTEND_ORIGIN=http://localhost:8765,https://adicmu.github.io

# Local dev only — Flask debug mode + dev port
FLASK_DEBUG=1
PORT=5000

# ── Password-reset email (SMTP) ──────────────────────────────
# Leave SMTP_HOST empty for local dev: forgot-password returns the reset link
# inline (dev convenience) instead of emailing it. Fill these to send real
# emails (works with Gmail app passwords, SendGrid SMTP, a CMU relay, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public URL of the deployed frontend — used to build the reset link in emails.
PUBLIC_APP_URL=https://adicmu.github.io/Countsfor-Summer-26/

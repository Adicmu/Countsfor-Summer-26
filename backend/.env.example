# Copy this file to `.env` for local development.
# In production (Render), set these as env vars in the dashboard instead.

# Random 32+ byte string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-me-locally

# SQLite for local dev. Production: Render Postgres connection string.
DATABASE_URL=sqlite:///countsfor.db
ALLOW_SQLITE=1

# Google OAuth client ID — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Optional. Restrict signups to one email domain.
ALLOWED_EMAIL_DOMAIN=andrew.cmu.edu

# CORS allow-list (origins only, comma-separated).
FRONTEND_ORIGIN=http://localhost:8765,https://adicmu.github.io

# Local dev: show reset links in API responses instead of emailing.
EXPOSE_RESET_TOKEN=1

# ── Password-reset email (production) ─────────────────────────
# Option A — Resend (recommended): https://resend.com
# RESEND_API_KEY=
# MAIL_FROM=CountsFor <onboarding@yourdomain.com>

# Option B — Gmail SMTP (Google App Password required)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=16-char-app-password
# MAIL_FROM=your-gmail@gmail.com

# Reset link target (GitHub Pages index.html)
FRONTEND_RESET_BASE=http://localhost:8765/index.html

FLASK_DEBUG=1
PORT=5050
